# Copy to backend/.env  (never commit the real file)
# AI Green Advisor (optional - the app works without it, using rule-based suggestions)
ANTHROPIC_API_KEY=
GC_AI_MODEL=claude-sonnet-5

# Estimation assumptions (all configurable)
GC_POWER_WATTS=15
GC_CARBON_INTENSITY=475
GC_RUNS=5
GC_RUN_TIMEOUT=5
